<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrosense.ui.AlertRulesController"
      spacing="0" styleClass="content-area">

    <!-- Header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Alert Rules" styleClass="title-large"/>
            <Label text="Configure thresholds for each site" styleClass="label-secondary"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="siteCombo" styleClass="combo-box" promptText="Select site" prefWidth="200"
                  onAction="#onSiteSelected"/>
        <Button text="＋ Add Rule" styleClass="btn-primary" onAction="#onAddRule"/>
    </HBox>

    <Region prefHeight="16"/>

    <!-- Rules table -->
    <TableView fx:id="rulesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colType"      text="READING TYPE" prefWidth="160"/>
            <TableColumn fx:id="colOperator"  text="CONDITION"    prefWidth="120"/>
            <TableColumn fx:id="colThreshold" text="THRESHOLD"    prefWidth="120"/>
            <TableColumn fx:id="colActive"    text="ACTIVE"       prefWidth="90"/>
            <TableColumn fx:id="colActions"   text="ACTIONS"      prefWidth="180"/>
        </columns>
    </TableView>

    <!-- Add / Edit form -->
    <VBox fx:id="formPane" styleClass="card" spacing="14" managed="false" visible="false">
        <Label fx:id="formTitle" text="Add Alert Rule" styleClass="title-medium"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Reading Type" styleClass="field-label"/>
                <ComboBox fx:id="typeCombo" styleClass="combo-box" prefWidth="160"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Condition" styleClass="field-label"/>
                <ComboBox fx:id="operatorCombo" styleClass="combo-box" prefWidth="130"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Threshold" styleClass="field-label"/>
                <TextField fx:id="thresholdField" styleClass="text-field" prefWidth="100" promptText="e.g. 30"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Save" styleClass="btn-primary" onAction="#onSaveRule" prefHeight="38"/>
            <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancelForm" prefHeight="38"/>
        </HBox>
        <Label fx:id="formError" styleClass="error-label" text="" visible="false" managed="false"/>
    </VBox>

</VBox>
