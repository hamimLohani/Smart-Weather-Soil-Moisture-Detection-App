<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.agrosense.ui.LoginController"
           styleClass="auth-container"
           alignment="CENTER">

    <VBox styleClass="auth-card" spacing="0" alignment="CENTER"
          maxWidth="440" maxHeight="-Infinity" StackPane.alignment="CENTER">

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="🌱 AgroSense" styleClass="auth-logo"/>
            <Label text="Smart Soil &amp; Weather Monitoring" styleClass="auth-tagline"/>
        </VBox>

        <Region prefHeight="32"/>

        <Label text="Welcome back" styleClass="title-medium"/>
        <Label text="Sign in to your account" styleClass="label-secondary" wrapText="true"/>

        <Region prefHeight="24"/>

        <!-- Email -->
        <VBox spacing="6">
            <Label text="Email address" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="alice@example.com"
                       styleClass="text-field" minWidth="360"/>
        </VBox>

        <Region prefHeight="14"/>

        <!-- Password -->
        <VBox spacing="6">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Your password"
                           styleClass="text-field" minWidth="360"/>
        </VBox>

        <Region prefHeight="6"/>

        <!-- Error -->
        <Label fx:id="errorLabel" styleClass="error-label" text=""
               managed="false" visible="false" maxWidth="360" wrapText="true"/>

        <Region prefHeight="16"/>

        <Button fx:id="loginButton" text="Sign In" styleClass="btn-primary"
                onAction="#onLogin" minWidth="360" prefHeight="42"/>

        <Region prefHeight="16"/>

        <HBox alignment="CENTER" spacing="6">
            <Label text="Don't have an account?" styleClass="label-secondary"/>
            <Button text="Create account" styleClass="link-button" onAction="#goToRegister"/>
        </HBox>

        <Region prefHeight="24"/>

        <!-- Demo hint -->
        <VBox styleClass="info-banner" spacing="4" maxWidth="360">
            <Label text="💡 Demo accounts" styleClass="text-accent"/>
            <Label text="Email:    alice@example.com  |  bob@example.com"
                   styleClass="label-muted"/>
            <Label text="Password: Demo@Agro#1"
                   styleClass="label-muted"/>
        </VBox>

    </VBox>

    <Button fx:id="themeToggleButton" text="☀️" styleClass="btn-icon" onAction="#onToggleTheme" StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="20" right="20"/>
        </StackPane.margin>
    </Button>
</StackPane>
