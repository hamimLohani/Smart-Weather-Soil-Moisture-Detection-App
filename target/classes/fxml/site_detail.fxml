<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrosense.ui.SiteDetailController"
      spacing="0" styleClass="content-area">

    <!-- Header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <Button text="← Back" styleClass="btn-secondary" onAction="#goBack"/>
        <VBox spacing="2">
            <Label fx:id="siteNameLabel" text="Site Detail" styleClass="title-large"/>
            <Label fx:id="siteProfileLabel" text="" styleClass="label-secondary"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Date range -->
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Label text="From" styleClass="label-secondary"/>
            <DatePicker fx:id="fromDate" styleClass="date-picker" prefWidth="140"/>
            <Label text="To" styleClass="label-secondary"/>
            <DatePicker fx:id="toDate" styleClass="date-picker" prefWidth="140"/>
            <Button text="Load" styleClass="btn-primary" onAction="#onLoadChart"/>
        </HBox>
    </HBox>

    <Region prefHeight="16"/>

    <!-- Current readings strip -->
    <HBox spacing="16">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
            <Label text="🌡 Temperature" styleClass="metric-label"/>
            <Label fx:id="tempLabel" text="—" styleClass="metric-value"/>
            <Label text="°C" styleClass="label-secondary"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
            <Label text="💧 Humidity" styleClass="metric-label"/>
            <Label fx:id="humLabel" text="—" styleClass="metric-value"/>
            <Label text="\%" styleClass="label-secondary"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="4" alignment="CENTER">
            <Label text="🌱 Soil Moisture" styleClass="metric-label"/>
            <Label fx:id="soilLabel" text="—" styleClass="metric-value"/>
            <Label text="\%" styleClass="label-secondary"/>
        </VBox>
    </HBox>

    <Region prefHeight="16"/>

    <!-- Chart -->
    <LineChart fx:id="readingsChart" VBox.vgrow="ALWAYS" styleClass="chart"
               animated="false" createSymbols="true">
        <xAxis><CategoryAxis fx:id="xAxis" label="Time"/></xAxis>
        <yAxis><NumberAxis fx:id="yAxis" label="Value"/></yAxis>
    </LineChart>

</VBox>
