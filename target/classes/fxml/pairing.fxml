<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.agrosense.ui.PairingController"
      spacing="0" styleClass="content-area">

    <!-- Header -->
    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Pair a New Device" styleClass="title-large"/>
            <Label text="Enter the pairing code found on your device packaging" styleClass="label-secondary"/>
        </VBox>
    </HBox>

    <Region prefHeight="24"/>

    <!-- Two-column: form + instructions -->
    <HBox spacing="24" VBox.vgrow="ALWAYS" alignment="TOP_LEFT">

        <!-- Form card -->
        <VBox styleClass="card" spacing="20" prefWidth="480">
            <Label text="Device Pairing" styleClass="title-medium"/>

            <VBox spacing="6">
                <Label text="Pairing Code" styleClass="field-label"/>
                <TextField fx:id="codeField" promptText="AGRO-XXXX-XXXX"
                           styleClass="text-field" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Site Name" styleClass="field-label"/>
                <TextField fx:id="siteNameField" promptText="e.g. Backyard Garden"
                           styleClass="text-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Site Profile" styleClass="field-label"/>
                <ComboBox fx:id="profileCombo" styleClass="combo-box" maxWidth="1e9"/>
            </VBox>

            <!-- Feedback -->
            <Label fx:id="feedbackLabel" styleClass="error-label" text="" wrapText="true"
                   managed="false" visible="false"/>
            <Label fx:id="successLabel" styleClass="text-accent" text="" wrapText="true"
                   managed="false" visible="false"/>

            <HBox spacing="12">
                <Button fx:id="pairButton" text="Pair Device" styleClass="btn-primary"
                        onAction="#onPair" prefHeight="42"/>
                <Button text="Cancel" styleClass="btn-secondary" onAction="#goBack" prefHeight="42"/>
            </HBox>
        </VBox>

        <!-- Instructions card -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <Label text="📦 Where is my pairing code?" styleClass="title-medium"/>
            <Label text="Your pairing code is printed on a sticker inside your AgroNode device box. It has the format AGRO-XXXX-XXXX."
                   styleClass="label-secondary" wrapText="true"/>
            <Separator/>
            <Label text="Site Profiles" styleClass="title-medium"/>
            <VBox spacing="8">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🏡 HOME" styleClass="badge-home"/>
                    <Label text="For residential gardens. You'll get simple threshold alerts."
                           styleClass="label-secondary" wrapText="true" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🌾 FARM" styleClass="badge-farm"/>
                    <Label text="For agricultural sites. Sites with issues are highlighted on your dashboard."
                           styleClass="label-secondary" wrapText="true" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </VBox>

    </HBox>
</VBox>
